# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Per-machine settings that override .env (never committed or deployed)
.env.local

# Local databases
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# User-uploaded media
storage/media/
# Excel import / export job files (contain personal and bank data)
storage/exchange/
exchange_data/
# SQLite WAL side files
*.db-wal
*.db-shm

# Runtime scratch space (load-test output, temp files)
storage/temp/
storage/exports/
storage/backups/

# Tool caches
.pytest_cache/

# Editor / OS
.vscode/
.DS_Store
Thumbs.db

# PyInstaller build output
build/
dist/
*.spec.bak
