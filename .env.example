# Quickyee settings: copy to .env (setup.bat / setup.sh do it for you) and fill in.
# Never commit .env — only this template belongs in git.

# At least 32 characters; setup generates a random one
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-chars

# Super Admin created automatically on the first start (when none exists)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# development | testing | staging | production
ENVIRONMENT=development

# Address the run scripts bind to (0.0.0.0 = every network interface)
HOST=0.0.0.0
PORT=8600

# Database: SQLite or PostgreSQL, pick one line. Tables are created / migrated on start.
# See docs/DATABASE.md. Nothing is copied when you switch.
DATABASE_URL=sqlite+aiosqlite:///storage/database/realtime_transfer.db
# PostgreSQL (the database must exist):
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/<database>
